<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The foreground poll service keeps statuses alive without a process death
         (Cityray reference pattern, docs/hvac-widget-app.md 3). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Car writes go through the ECARX adaptapi; the firmware rejects writes without
         these (S006). Unknown on non-Geely platforms - silently ignored there. -->
    <uses-permission android:name="geely.oneos.permission.SERVICE" />
    <uses-permission android:name="geely.oneos.permission.CAR_VENDOR_EXTENSION" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_widget"
        android:label="@string/app_name">

        <!-- Stock AppWidget registration (docs/hvac-widget-app.md 2): no Geely-specific
             element - the OneOS launcher is a standard AppWidgetHost and lists providers
             through the system AppWidgetService. -->
        <receiver
            android:name=".ClimateWidgetProvider"
            android:label="@string/widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/climate_widget_info" />
        </receiver>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The status poller: foreground keeps the read cycle alive without a process
             death (docs/hvac-widget-app.md 3, Cityray reference pattern). -->
        <service
            android:name=".service.StatusPollService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
