<?xml version="1.0" encoding="utf-8"?>
<!-- The widget face: 3x3 grid. The registry render (Task 2) targets these slots; the third
     memory button exists for the Atlas profile (3 slots, geely-references 2e) and is set
     GONE by the renderer for models with fewer positions (Cityray: two). View classes stay
     within RemoteViews' whitelist (TextView inside LinearLayouts). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/widget_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_wheel"
            style="@style/WidgetButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_wheel" />

        <TextView
            android:id="@+id/btn_seat_driver"
            style="@style/WidgetButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/btn_seat_driver" />

        <TextView
            android:id="@+id/btn_seat_passenger"
            style="@style/WidgetButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/btn_seat_passenger" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_defrost_front"
            style="@style/WidgetButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_defrost_front" />

        <TextView
            android:id="@+id/btn_defrost_rear"
            style="@style/WidgetButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/btn_defrost_rear" />

        <TextView
            android:id="@+id/btn_recirc"
            style="@style/WidgetButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/btn_recirc" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_memory_1"
            style="@style/WidgetButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_memory_1" />

        <TextView
            android:id="@+id/btn_memory_2"
            style="@style/WidgetButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/btn_memory_2" />

        <TextView
            android:id="@+id/btn_memory_3"
            style="@style/WidgetButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/btn_memory_3" />
    </LinearLayout>
</LinearLayout>
