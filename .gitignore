# The CMake rule above is unanchored and swallows the harness root Makefile
# (real hand-written task runner, not a CMake artifact). Same pattern as the
# playstore/ re-include below; do not drop this line.
!Makefile

#
cert/
# Store assets and keys at the repo root. The pattern is unanchored, so it also swallowed the
# playstore *product flavor* source set - which is why app/src/playstore/ could never be committed
# and the flavor had no VpnControl. Re-included below; do not drop that line.
playstore/
!app/src/playstore/
